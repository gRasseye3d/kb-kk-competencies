# Knowledge Base - Docker environment
#
# Copy this file to .env before starting Docker Compose:
# cp .env.example .env
#
# Never commit the real .env file.

# PostgreSQL password.
# Use a long, randomly generated password.
#
# IMPORTANT:
# The current compose.yaml also inserts this password
# into DATABASE_URL. Until URL encoding is implemented,
# avoid characters that require URL encoding.
DB_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD

# HTTPS listening address.
# 127.0.0.1 = local access only.
# Set an appropriate interface address for remote access.
KB_HTTPS_BIND=127.0.0.1

# Host port mapped to container HTTPS port 443.
KB_HTTPS_PORT=8443
